# Copy this file to .env and fill in the values locally.
# This file contains NAMES ONLY. It must never contain a real value.
# Nothing here is ever read by the browser.

# ── Model (server only) ──────────────────────────────────────────────────────
# Default is Gemini's free tier (no card required). OpenAI is optional and is
# NOT free beyond any trial credit you may have.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Firebase admin (server only) ─────────────────────────────────────────────
# Use ONE of the two. The JSON string wins if both are set.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Email (optional; without it replies are marked "skipped") ────────────────
RESEND_API_KEY=
OUTBOUND_EMAIL_DOMAIN=
CONTACT_REPLY_FROM=
CONTACT_REPLY_TO=

# ── Review page ──────────────────────────────────────────────────────────────
TRIAGE_REVIEW_TOKEN=

# ── Server ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=
PORT=
