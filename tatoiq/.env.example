# ─────────────────────────────────────────────────────────────────────────────
# TatoIQ environment variables — NAMES ONLY. Never commit real values.
# Copy to `.env.local` and fill in locally. Production uses the host's secret store.
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL). For local dev use Docker or a free Neon/Supabase instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tatoiq?schema=public"

# Auth (Auth.js / NextAuth)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Saggio / LLM. Leave blank to run Saggio in offline grounded mode (no external calls).
OPENAI_API_KEY=""
SAGGIO_MODEL=""

# Saggio client mode — SERVER-ONLY. Never prefix these with NEXT_PUBLIC_.
# The `customers` collection is read and written only by /api/assistant. Provide
# ONE credential source:
#   FIREBASE_SERVICE_ACCOUNT_JSON  the JSON itself (single line; preferred on Netlify)
#   GOOGLE_APPLICATION_CREDENTIALS path to the service-account JSON file
#   FIREBASE_ACCESS_TOKEN          short-lived token, for local checks only
# With none set, Saggio says records are unavailable instead of guessing.
FIREBASE_PROJECT_ID="web-app---tato"
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_ACCESS_TOKEN=""

# Optional Triage Agent. When set, routed client messages are POSTed here. When
# unset or unavailable, a deterministic local fallback picks the team and no
# response time is promised. The key stays server-side.
TRIAGE_AGENT_URL=""
TRIAGE_AGENT_API_KEY=""

# Field-level encryption (dev-only key; production uses AWS KMS key ARN)
# 32-byte key, base64. NEVER use this dev key in production.
FIELD_ENCRYPTION_KEY=""

# Storage / document pipeline (adapters; see docs/ARCHITECTURE.md)
STORAGE_DRIVER="local" # local | s3
AWS_REGION=""
S3_BUCKET_PRIMARY=""
S3_BUCKET_QUARANTINE=""
KMS_KEY_ARN=""

# Email / notifications
NOTIFICATION_DRIVER="console" # console | ses
SES_FROM_ADDRESS=""

# Observability
SENTRY_DSN=""

# E-signature (Form 8879) — adapter, disabled for MVP demo
ESIGN_DRIVER="disabled" # disabled | docusign
DOCUSIGN_INTEGRATION_KEY=""

# Billing (Stripe) — test mode only until approved
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Plaid — sandbox only; disabled for MVP
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# ─────────────────────────────────────────────────────────────────────────────
# Lead Generation Agent
# ─────────────────────────────────────────────────────────────────────────────

# Build mode. Leave unset for a normal Next.js SERVER build (required for the
# lead feature's API routes, Prisma, webhooks, and dispatch). Set to "export"
# ONLY if you want a static-only bundle.
NEXT_OUTPUT=""

# Organization scoping used by mock mode and the seed script.
DEFAULT_ORGANIZATION_ID="org_demo"

# Auth fallback: when a real session cookie is absent outside production, a
# clearly-marked mock ADMIN is used so the feature demos without an IdP.
ALLOW_MOCK_AUTH="true"

# Phase feature flags — incomplete integrations stay DARK (404) when false.
FEATURE_LEADS="true"
FEATURE_LEAD_IMPORT="true"
FEATURE_DISCOVERY="false"
FEATURE_AI_DRAFTING="false"
FEATURE_OUTREACH_DISPATCH="false"
FEATURE_CONSULTATION_BOOKING="false"
FEATURE_CALIBRATION="false"

# Thresholds (all overridable; sensible defaults baked in).
PHASE2_UNLOCK_VALIDATED_LEADS="50"
CALIBRATION_MIN_CLOSED_CONVERSIONS="50"
OUTREACH_MAX_DAILY_EMAILS="100"
OUTREACH_WARMUP_DAY_ONE="20"
LEAD_REASSIGN_AFTER_HOURS="24"
LEAD_SLA_WARN_AFTER_HOURS="24"
LEAD_STALE_RESEARCHING_DAYS="14"

# Outbound email (Resend). Without RESEND_API_KEY + OUTBOUND_EMAIL_DOMAIN the
# transport falls back to a labelled console logger — never a fake "sent".
RESEND_API_KEY=""
OUTBOUND_EMAIL_DOMAIN=""
RESEND_WEBHOOK_SECRET=""

# Webhooks / unsubscribe (signed tokens).
CAL_WEBHOOK_SECRET=""
OUTREACH_UNSUBSCRIBE_SECRET=""

# Booking confirmation + integrations.
BOOKING_CONFIRMATION_PATH="/booked"
BILLING_SYSTEM="manual"          # manual | stripe
LEAD_DATA_PROVIDER=""            # unset => mock discovery ("Development Mock Mode")
LEAD_ALERT_CHANNEL="in_app"      # in_app | slack | teams

# Seed script (npm run db:seed) — number of synthetic profiles to create.
SEED_LEAD_COUNT="50"

# ─────────────────────────────────────────────────────────────────────────────
# CCO Triage Agent — Netlify Function at netlify/functions/cco-triage.mjs
# ─────────────────────────────────────────────────────────────────────────────
# Server-side model key for triage. Reuses OPENAI_API_KEY above. With no key the
# function returns 503 and writes nothing; it never fabricates a triage result.
# NEVER prefix this with NEXT_PUBLIC_.
CCO_TRIAGE_MODEL="gpt-4o-mini"

# Extra browser origins allowed to call the function, comma-separated. The
# site's own origin (URL / DEPLOY_PRIME_URL) is always allowed. Never use "*".
CCO_ALLOWED_ORIGINS=""

# Gates origin-less server-to-server calls (inbox webhooks, cron). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Browser calls are gated by origin instead, so the token is not shipped to the
# page. Set CCO_REQUIRE_TOKEN=true to require it on every call.
CCO_TRIAGE_TOKEN=""
CCO_REQUIRE_TOKEN="false"

# Best-effort per-instance limit. Set to 0 to disable.
CCO_RATE_LIMIT_PER_10MIN="60"
CCO_TRIAGE_TIMEOUT_MS="20000"

# Netlify Blobs. On Netlify the credentials are injected automatically; leave
# the two credential names blank there. They are only for local runs outside
# `netlify dev`. Do not change the store name after records exist.
CCO_BLOBS_STORE="cco-customers"
CCO_BLOBS_SITE_ID=""
CCO_BLOBS_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# Contact-form triage — Netlify Functions at netlify/functions/contact-triage*.mjs
# ─────────────────────────────────────────────────────────────────────────────
# Flow: the form saves to Firestore `contacts`, then calls this function with the
# new document id. The function triages, writes the decision onto the record,
# and sends one reply. Firestore is reached over REST with the credentials
# above; no Cloud Functions and no Firebase billing plan are involved.
#
# Browser URL of POST /api/contacts/triage. Leave blank when the form is served
# by the Netlify site (same origin). Set it to the full Netlify URL when the form
# is served from the static Firebase mirror. This one is public by design.
NEXT_PUBLIC_CONTACT_TRIAGE_URL=""

# Extra browser origins allowed to call the triage function, comma-separated.
# The Netlify site origin and https://web-app---tato.web.app are always allowed.
CONTACT_TRIAGE_ALLOWED_ORIGINS=""

# Best-effort per-instance limit. Set to 0 to disable.
CONTACT_TRIAGE_RATE_LIMIT_PER_10MIN="30"

# Reply identity. CONTACT_REPLY_FROM falls back to hello@OUTBOUND_EMAIL_DOMAIN.
# CONTACT_REPLY_TO is optional and only sets the Reply-To header.
CONTACT_REPLY_FROM=""
CONTACT_REPLY_TO=""

# Token for the owner-only review page at /api/contacts/review. The page shows
# real messages, so it refuses to render without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Open it as https://<site>/api/contacts/review?token=<value>
TRIAGE_REVIEW_TOKEN=""
